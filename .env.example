# Example Environment Configuration for 'The Relay'
# Copy this file to .env or export GROQ_API_KEY in your shell.
# NOTE: As per the brief guidelines, never commit or share your raw secret API key!

# Your free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Default model ID for production runs
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

